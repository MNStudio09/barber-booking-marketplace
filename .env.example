# Supabase — create a free project at https://supabase.com, then copy these
# values from Project Settings → API. NEVER commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used ONLY by server actions / route handlers for admin and
# settlement writes. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# City the marketplace serves. The city is still TBD — set this when the
# launch city is chosen. Keep it generic until then.
NEXT_PUBLIC_CITY=Your City

# --- Real payment integration (LATER PHASE — do not fill these in yet) ---
# Payments in this build are SIMULATED. Real JazzCash / Easypaisa / bank
# collection needs an authorised payment-provider / bank marketplace
# arrangement first. When that exists, add its credentials here and flip
# the integration points in lib/payments.ts from simulated to live.
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=
